// calculator.glr
// This is a complete grammar specification for a simple calculator.

@prologue %{
    use crate::ast::{Expression, Operator};
    use std::num::ParseIntError;
}%

%tokens {
    // Lexical rules defined with regular expressions
    NUMBER = "[0-9]+";
    PLUS   = "\+";
    MINUS  = "\-";
    MUL    = "\*";
    DIV    = "/";
    LPAREN = "\(";
    RPAREN = "\)";
}

%skip {
    WS = "[ \t\r\n]+";
}

%start Program

%rules {
    // The Context-Free Grammar, stratified to enforce precedence
    Program ->
        Expr ;

    // Lowest precedence operations (evaluated last)
    Expr ->
        Expr PLUS Term
      | Expr MINUS Term
      | Term ;

    // Higher precedence operations (evaluated first)
    Term ->
        Term MUL Factor
      | Term DIV Factor
      | Factor ;

    // Highest precedence (numbers and explicit grouping)
    Factor ->
        LPAREN Expr RPAREN
      | NUMBER ;
}

@epilogue %{
    use std::fs;

    pub fn report_error(line: usize, msg: &str) {
        eprintln!("Parse Error [Line {}]: {}", line, msg);
    }

    // Since this epilogue gets appended directly into the generated module,
    // it can directly access the generated Lexer, Parser, and ParseTree structs!
    pub fn main() {
        println!("--- Starting Parser Test ---");

        // 1. Read the input file
        let input_path = "test_input.txt";
        let input = fs::read_to_string(input_path)
            .expect(&format!("Failed to read {} - make sure it exists in the project root", input_path));

        println!("Parsing expression:\n{}\n", input.trim());

        // 2. Initialize the generated Lexer with a reference to the input string
        let lexer = Lexer::new(&input);

        // 3. Initialize the generated Parser
        let mut parser = Parser::new(lexer);

        // 4. Run the parser engine and print the Graph-Structured Stack tree
        match parser.parse() {
            Ok(tree) => {
                println!("Parsing Successful!");
                println!("Abstract Syntax Tree:\n{:#?}", tree);
            }
            Err(e) => {
                report_error(parser.lexer.line, &e);
            }
        }
    }
}%
