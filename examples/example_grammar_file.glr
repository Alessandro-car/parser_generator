// calculator.glr
// This is a complete grammar specification for a simple calculator.

@prologue %{
    use crate::ast::{Expression, Operator};
    use std::num::ParseIntError;
}%

%tokens {
    // Lexical rules defined with regular expressions
    NUMBER = "[0-9]+";
    PLUS   = "\+";
    MINUS  = "\-";
    MUL    = "\*";
    DIV    = "/";
    LPAREN = "\(";
    RPAREN = "\)";
}

%skip {
    WS = "[ \t\r\n]+";
}

%start Program

%rules {
    // The Context-Free Grammar, stratified to enforce precedence
    Program ->
        Expr ;

    // Lowest precedence operations (evaluated last)
    Expr ->
        Expr PLUS Term
      | Expr MINUS Term
      | Term ;

    // Higher precedence operations (evaluated first)
    Term ->
        Term MUL Factor
      | Term DIV Factor
      | Factor ;

    // Highest precedence (numbers and explicit grouping)
    Factor ->
        LPAREN Expr RPAREN
      | NUMBER ;
}

@epilogue %{
    pub fn report_error(line: usize, msg: &str) {
        eprintln!("Parse Error [Line {}]: {}", line, msg);
    }

    fn main() {
        println!("Calculator parser generated successfully!");
    }
}%
